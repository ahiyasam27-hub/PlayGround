<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#101a2b">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='28' fill='%231a2b40' stroke='%23ffcb6b' stroke-width='3'/%3E%3Cpath d='M32 10 37 27 54 32 37 37 32 54 27 37 10 32 27 27Z' fill='%23ffcb6b'/%3E%3C/svg%3E">
<title>Emberfall — The Lost Blade</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Marcellus&display=swap');
:root{color-scheme:dark;--cream:#f6e8c9;--gold:#ffcb6b;--muted:#a9b5c5;--glass:rgba(15,26,43,.76)}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#101a2b;font-family:'DM Sans',system-ui,sans-serif;touch-action:none;user-select:none;-webkit-user-select:none}body{display:grid;place-items:center}.shell{position:relative;width:min(100vw,177.78vh);height:min(100vh,56.25vw);min-height:280px;overflow:hidden;background:#17283b;isolation:isolate}canvas{display:block;width:100%;height:100%;image-rendering:auto}.vignette{position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(8,15,28,.26),transparent 25%,transparent 73%,rgba(9,15,27,.45));z-index:1}.hud{position:absolute;inset:0;z-index:2;pointer-events:none;color:var(--cream)}.brand{position:absolute;top:clamp(14px,3.8vh,34px);left:clamp(16px,4vw,48px);display:flex;align-items:center;gap:12px}.brand-mark{width:37px;height:37px;border:1px solid rgba(255,203,107,.65);border-radius:50%;display:grid;place-items:center;color:var(--gold);font-size:20px;box-shadow:0 0 24px #ffc55b2a}.brand small{display:block;color:#cad2dc;font-size:9px;letter-spacing:.23em;font-weight:700}.brand strong{display:block;font:16px 'Marcellus',serif;letter-spacing:.1em;margin-top:3px}.status{position:absolute;top:clamp(15px,3.8vh,34px);right:clamp(16px,4vw,48px);display:flex;align-items:center;gap:10px}.panel{background:var(--glass);border:1px solid #ffffff20;backdrop-filter:blur(12px);box-shadow:0 8px 26px #050d1880}.health{padding:9px 13px;border-radius:12px;min-width:145px}.label{font-size:9px;letter-spacing:.19em;font-weight:800;color:#b8c5d1}.hearts{display:flex;gap:4px;margin-top:5px;font-size:16px;color:#ff796f;line-height:1}.hearts .empty{color:#596472}.collect{height:42px;padding:0 14px;border-radius:12px;display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700}.coin-icon{width:14px;height:14px;border-radius:50%;background:#ffca66;border:2px solid #ffe4a8;box-shadow:0 0 10px #ffc4568c}.pause{pointer-events:auto;color:#f5e8cf;border:1px solid #ffffff24;border-radius:12px;background:var(--glass);height:42px;width:42px;font-size:17px;cursor:pointer}.quest{position:absolute;left:clamp(16px,4vw,48px);top:94px;padding:10px 14px;border-left:2px solid var(--gold);font-size:11px;color:#dae0e5;letter-spacing:.03em;text-shadow:0 2px 6px #000}.quest b{display:block;font-size:9px;letter-spacing:.17em;color:var(--gold);margin-bottom:3px}.center{position:absolute;inset:0;display:grid;place-items:center;pointer-events:auto;background:radial-gradient(ellipse at center,rgba(9,19,33,.28),rgba(8,15,28,.64));transition:opacity .25s}.center.hidden{opacity:0;pointer-events:none}.card{width:min(440px,88%);text-align:center;padding:clamp(22px,5vh,42px);border:1px solid #ffe5b538;border-radius:22px;background:linear-gradient(145deg,rgba(20,35,54,.96),rgba(15,26,43,.96));box-shadow:0 24px 80px #020711aa;position:relative}.card:before{content:'';position:absolute;inset:7px;border:1px solid #ffffff0d;border-radius:16px;pointer-events:none}.eyebrow{font-size:9px;letter-spacing:.3em;color:var(--gold);font-weight:800}.card h1{font:clamp(32px,6vw,48px) 'Marcellus',serif;line-height:1.04;margin:12px 0 8px;color:#fff0d4;text-shadow:0 3px 22px #ffc66a36}.card p{font-size:13px;line-height:1.65;color:#b7c3d0;margin:0 auto 20px;max-width:330px}.primary{border:0;border-radius:11px;background:linear-gradient(135deg,#ffd784,#e9a94f);color:#322417;font:800 12px 'DM Sans',sans-serif;letter-spacing:.13em;padding:13px 24px;min-width:164px;box-shadow:0 7px 20px #f4b85238;cursor:pointer}.primary:active{transform:translateY(1px)}.hint{margin-top:14px!important;font-size:10px!important;color:#8291a3!important}.mobile-controls{display:none;position:absolute;inset:auto 0 0;z-index:3;justify-content:space-between;align-items:end;padding:0 20px max(16px,env(safe-area-inset-bottom));pointer-events:none}.control-cluster{display:flex;gap:10px;align-items:center}.control{pointer-events:auto;width:58px;height:58px;border:1px solid #ffffff42;border-radius:50%;background:#1322379c;color:#f9edda;display:grid;place-items:center;font-size:22px;box-shadow:0 5px 16px #07111f68;backdrop-filter:blur(5px);touch-action:none}.control:active,.control.pressed{background:#ffcc6cbb;color:#172131;transform:scale(.96)}.control.small{width:50px;height:50px;font-size:18px}.control.jump{width:68px;height:68px;color:#ffda8b;font-weight:800}.control.attack{width:58px;height:58px;color:#ffa19a}.mobile-controls .movement{gap:9px}.toast{position:absolute;left:50%;top:26%;transform:translate(-50%,-8px);padding:10px 16px;border-radius:10px;background:#102035de;border:1px solid #ffdc9140;color:#ffe5b7;font-size:12px;letter-spacing:.04em;opacity:0;transition:.3s;white-space:nowrap}.toast.show{opacity:1;transform:translate(-50%,0)}.touch-hint{position:absolute;bottom:15px;left:50%;transform:translateX(-50%);font-size:9px;color:#ffffff88;letter-spacing:.1em;pointer-events:none}.hidden{display:none!important}
@media (pointer:coarse),(max-width:760px){.shell{width:100vw;height:100dvh;min-height:0}.mobile-controls{display:flex}.brand{top:max(12px,env(safe-area-inset-top));left:14px}.brand-mark{width:31px;height:31px;font-size:17px}.brand strong{font-size:13px}.brand small{font-size:7px}.status{top:max(12px,env(safe-area-inset-top));right:12px;gap:6px}.health{padding:7px 9px;min-width:95px}.hearts{font-size:13px;margin-top:3px}.collect{height:36px;padding:0 9px;font-size:11px;gap:6px}.pause{height:36px;width:36px}.quest{top:68px;left:14px;font-size:9px;padding:7px 10px}.quest b{font-size:8px}.touch-hint{display:none}.card{width:min(380px,88%);padding:25px 20px}.card h1{font-size:36px}.card p{font-size:12px}}
@media (max-width:540px) and (min-height:431px){.status{top:max(52px,calc(env(safe-area-inset-top) + 40px));left:12px;right:12px;justify-content:flex-end}.quest{top:104px;left:14px}}
@media (max-height:430px) and (pointer:coarse){.brand,.status{top:7px}.quest{top:55px}.mobile-controls{padding-bottom:8px}.control{width:49px;height:49px}.control.jump{width:57px;height:57px}.card{padding:14px 20px}.card h1{font-size:30px;margin:6px 0}.card p{margin-bottom:10px}}
.control-cluster.movement{display:grid;grid-template-columns:repeat(3,50px);grid-template-rows:repeat(3,50px);gap:3px}.movement .control:nth-child(1){grid-column:2;grid-row:1}.movement .control:nth-child(2){grid-column:1;grid-row:2}.movement .control:nth-child(3){grid-column:2;grid-row:3}.movement .control:nth-child(4){grid-column:3;grid-row:2}.control.jump{display:none}
</style>
</head>
<body>
<main class="shell" id="shell">
<canvas id="game" aria-label="Emberfall isometric adventure game"></canvas><div class="vignette"></div>
<div class="hud">
<div class="brand"><div class="brand-mark">✦</div><div><small>AN ADVENTURE BEGINS</small><strong>EMBERFALL</strong></div></div>
<div class="status"><div class="health panel"><div class="label">VITALITY</div><div class="hearts" id="hearts">♥♥♥</div></div><div class="collect panel"><span class="coin-icon"></span><span id="coinCount">0</span><span style="color:#ffffff70">·</span><span id="keyCount">0/5 keys</span></div><button class="pause" id="pause" aria-label="Pause">Ⅱ</button></div>
<div class="quest"><b id="questName">THE KING'S PROPHECY</b><span id="questText">Defeat the guardian and claim the key</span> <span style="color:#ffcb6b">◆</span></div>
<div class="toast" id="toast"></div>
<div class="center" id="overlay"><div class="card"><div class="eyebrow" id="eyebrow">A DOOR BETWEEN WORLDS</div><h1 id="title">The Lost Blade</h1><p id="message">Alone in the forest, a boy opens a strange door and is swept into another world. Found unconscious by a girl, he is taken to her king, who tells of a prophecy: a boy from another world will save these lands. Five nations, five keys—and then the portal home.</p><button class="primary" id="start">BEGIN THE QUEST</button><p class="hint" id="hint">Explore with <b>W A S D</b> or <b>← ↑ ↓ →</b> · Strike with <b>J</b></p></div></div>
</div>
<div class="mobile-controls" id="mobileControls"><div class="control-cluster movement"><button class="control small" data-key="up" aria-label="Move up">▲</button><button class="control small" data-key="left" aria-label="Move left">◀</button><button class="control small" data-key="down" aria-label="Move down">▼</button><button class="control small" data-key="right" aria-label="Move right">▶</button></div><div class="control-cluster"><button class="control attack" data-key="attack" aria-label="Sword attack">⚔</button></div></div>
</main>
<script>
(()=>{'use strict';
const canvas=document.getElementById('game'),ctx=canvas.getContext('2d'),shell=document.getElementById('shell');
const ui={overlay:document.getElementById('overlay'),title:document.getElementById('title'),message:document.getElementById('message'),eyebrow:document.getElementById('eyebrow'),hint:document.getElementById('hint'),start:document.getElementById('start'),hearts:document.getElementById('hearts'),coins:document.getElementById('coinCount'),keyCount:document.getElementById('keyCount'),questName:document.getElementById('questName'),questText:document.getElementById('questText'),pause:document.getElementById('pause'),toast:document.getElementById('toast')};
let W=960,H=540,dpr=1,screen='title',last=0,elapsed=0,toastTimer=0,camX=0,camY=0,hero,enemies,coins,checkpoints,gates,bosses,particles,keysFound=0;
const REGION=720,REGIONS=[{name:'Verdant Reach',boss:'Mossfang'},{name:'Frostveil Peaks',boss:'The Glacier Warden'},{name:'Sunken Coast',boss:'Tidecaller'},{name:'Ashen March',boss:'Cindermaw'},{name:'Starfall Crown',boss:'The Void King'}],WORLD=REGION*REGIONS.length,MAP_H=440,IX=.62,IY=.34;
const input={left:false,right:false,up:false,down:false,attack:false};
function resize(){const r=shell.getBoundingClientRect();dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(r.width*dpr);canvas.height=Math.round(r.height*dpr);W=r.width;H=r.height}
window.addEventListener('resize',resize);resize();
function reset(){hero={x:65,y:220,vx:0,vy:0,faceX:1,faceY:0,hp:5,invuln:0,attack:0,attackCd:0,checkpoint:{x:65,y:220}};enemies=[];coins=[];checkpoints=[];gates=[];bosses=[];particles=[];keysFound=0;for(let r=0;r<REGIONS.length;r++){let o=r*REGION;for(const [dx,y] of [[225,150],[370,300],[475,115]])enemies.push({x:o+dx,y,homeX:o+dx,homeY:y,hp:2,alive:true,phase:dx});for(const [dx,y] of [[165,250],[340,110],[445,340],[625,230]])coins.push({x:o+dx,y,taken:false});checkpoints.push({x:o+100,y:220,active:false},{x:o+410,y:220,active:false});gates.push({x:o+690,y:220,open:false,region:r});bosses.push({x:o+550,y:220,homeX:o+550,hp:4,maxHp:4,alive:true,region:r,hitCd:0})}camX=(hero.x-hero.y)*IX;camY=(hero.x+hero.y)*IY;updateHUD();updateQuest()}
reset();
function updateHUD(){ui.hearts.innerHTML=Array.from({length:5},(_,i)=>`<span class="${i>=hero.hp?'empty':''}">♥</span>`).join('');ui.coins.textContent=coins.filter(c=>c.taken).length;ui.keyCount.textContent=`${keysFound}/5 keys`}
function regionAt(x){return Math.max(0,Math.min(REGIONS.length-1,Math.floor(x/REGION)))}
function updateQuest(){let r=regionAt(hero.x),b=bosses[r];ui.questName.textContent=REGIONS[r].name.toUpperCase();ui.questText.textContent=b?.alive?`Defeat ${REGIONS[r].boss} and claim the key`:(r===REGIONS.length-1?'Reach the portal home':'Key claimed · continue to the next nation')}
function showToast(t){ui.toast.textContent=t;ui.toast.classList.add('show');toastTimer=1.8}
function begin(){if(screen==='win')reset();else if(screen==='dead'){hero.x=hero.checkpoint.x;hero.y=hero.checkpoint.y;hero.hp=5;hero.invuln=1.5;hero.attack=hero.attackCd=0;updateHUD();showToast('Back at the last campfire')}screen='playing';ui.overlay.classList.add('hidden');last=performance.now()}
ui.start.addEventListener('click',()=>{if(screen==='playing'){ui.overlay.classList.add('hidden');return}begin()});
function pauseGame(){if(screen==='playing'){screen='paused';ui.eyebrow.textContent='TAKE A BREATH';ui.title.textContent='Journey Paused';ui.message.textContent='Your adventure is waiting. The forest will be right where you left it.';ui.start.textContent='RESUME';ui.hint.textContent='Your progress is saved for this journey';ui.overlay.classList.remove('hidden')}else if(screen==='paused')begin()}
ui.pause.addEventListener('click',pauseGame);
function setKey(k,v){if(k in input)input[k]=v}
window.addEventListener('keydown',e=>{let k=e.key.toLowerCase();if(['arrowleft','arrowright','arrowup','arrowdown',' '].includes(k))e.preventDefault();if(k==='escape'){pauseGame();return}if(k==='enter'&&screen!=='playing'){begin();return}if(k==='arrowleft'||k==='a')setKey('left',true);if(k==='arrowright'||k==='d')setKey('right',true);if(k==='arrowup'||k==='w')setKey('up',true);if(k==='arrowdown'||k==='s')setKey('down',true);if(k==='j'||k==='x'||k===' ')setKey('attack',true)});
window.addEventListener('keyup',e=>{let k=e.key.toLowerCase();if(k==='arrowleft'||k==='a')setKey('left',false);if(k==='arrowright'||k==='d')setKey('right',false);if(k==='arrowup'||k==='w')setKey('up',false);if(k==='arrowdown'||k==='s')setKey('down',false);if(k==='j'||k==='x'||k===' ')setKey('attack',false)});
document.querySelectorAll('[data-key]').forEach(b=>{let k=b.dataset.key;const down=e=>{e.preventDefault();setKey(k,true);b.classList.add('pressed')},up=e=>{e.preventDefault();setKey(k,false);b.classList.remove('pressed')};b.addEventListener('pointerdown',down);['pointerup','pointercancel','pointerleave'].forEach(ev=>b.addEventListener(ev,up))});
function poly(points,color){ctx.fillStyle=color;ctx.beginPath();ctx.moveTo(points[0][0],points[0][1]);for(let i=1;i<points.length;i++)ctx.lineTo(points[i][0],points[i][1]);ctx.closePath();ctx.fill()}
function line(x1,y1,x2,y2,c,w=1){ctx.strokeStyle=c;ctx.lineWidth=w;ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke()}
function circle(x,y,r,c){ctx.fillStyle=c;ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fill()}
function rr(x,y,w,h,r,c){ctx.fillStyle=c;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()}
function seeded(n){let v=Math.sin(n*127.1+311.7)*43758.5453;return v-Math.floor(v)}
function project(x,y){return [W/2+(x-y)*IX-camX,H*.53+(x+y)*IY-camY]}
function drawSky(){let r=regionAt((camX/IX+camY/IY)/2),pal=[['#17283d','#385365','#b48662'],['#182d48','#527691','#bdd9e4'],['#10384b','#33768a','#dbc294'],['#301d2d','#754649','#c87951'],['#211a43','#514b80','#d5a5cc']][r];let g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,pal[0]);g.addColorStop(.58,pal[1]);g.addColorStop(1,pal[2]);ctx.fillStyle=g;ctx.fillRect(0,0,W,H);let sx=W*.76-camX*.035,sy=H*.23;let glow=ctx.createRadialGradient(sx,sy,2,sx,sy,W*.36);glow.addColorStop(0,'#ffe9b477');glow.addColorStop(1,'#ffd9a100');ctx.fillStyle=glow;ctx.fillRect(0,0,W,H);circle(sx,sy,Math.min(W,H)*.045,'#ffe7b0');for(let l=0;l<3;l++){let base=H*(.59+l*.105),step=180+l*55;ctx.fillStyle=['#536a71','#374f59','#263e4b'][l];ctx.beginPath();ctx.moveTo(0,H);for(let x=-step;x<W+step;x+=step){let peak=base-60-seeded(Math.floor((x+camX*.06)/step)+l*19)*100;ctx.lineTo(x,base);ctx.lineTo(x+step*.5,peak);ctx.lineTo(x+step,base)}ctx.lineTo(W,H);ctx.fill()}}
const palettes=[['#6b7655','#79845d','#64734f'],['#718998','#819aa4','#687f90'],['#477776','#568984','#3f6b70'],['#80563f','#926047','#754a42'],['#5b527e','#6d6191','#514c79']];
function drawGround(){for(let x=0;x<WORLD;x+=80)for(let y=0;y<MAP_H;y+=80){let [sx,sy]=project(x+40,y+40);if(sx<-90||sx>W+90||sy<-70||sy>H+70)continue;let r=regionAt(x),pal=palettes[r],variation=seeded(x*3+y*7)>.72?1:0;poly([[sx,sy-27],[sx+49,sy],[sx,sy+27],[sx-49,sy]],pal[variation]);line(sx-49,sy,sx,sy+27,'#ffffff0d',1);if(seeded(x+y*11)>.94){poly([[sx-9,sy-3],[sx+1,sy-8],[sx+8,sy-2],[sx+1,sy+2]],'#d6c28a55')}}
// Soft ambient sparks in the distance.
for(let i=0;i<20;i++){let x=(seeded(i+5)*W-camX*.06+elapsed*(5+seeded(i)*8))%W,y=H*(.24+seeded(i+40)*.48)+Math.sin(elapsed+i)*7;circle((x+W)%W,y,1.3,'#ffdfa044')}}
function drawTree(x,y,seed){let [sx,sy]=project(x,y);if(sx<-60||sx>W+60||sy<-110||sy>H+80)return;let r=regionAt(x),c=['#365448','#8ca3a6','#29616a','#74423c','#4f416f'][r],s=.75+seeded(seed)*.55;circle(sx,sy-29*s,5*s,'#302f2e');poly([[sx,sy-81*s],[sx-22*s,sy-29*s],[sx+22*s,sy-29*s]],c);poly([[sx,sy-60*s],[sx-27*s,sy-14*s],[sx+27*s,sy-14*s]],c);poly([[sx,sy-43*s],[sx-32*s,sy-2*s],[sx+32*s,sy-2*s]],c);line(sx-10*s,sy-17*s,sx+14*s,sy-17*s,'#ffffff18',2)}
function drawGate(g){let [x,y]=project(g.x,g.y),glow=g.open?.48+.18*Math.sin(elapsed*3):.16;ctx.save();ctx.globalAlpha=.95;poly([[x-38,y+24],[x-33,y-38],[x-22,y-67],[x,y-83],[x+22,y-67],[x+33,y-38],[x+38,y+24]],'#182934');ctx.strokeStyle=g.open?'#ffd27a':'#a48c68';ctx.lineWidth=5;ctx.beginPath();ctx.moveTo(x-38,y+24);ctx.lineTo(x-33,y-38);ctx.quadraticCurveTo(x,y-102,x+33,y-38);ctx.lineTo(x+38,y+24);ctx.stroke();ctx.globalAlpha=glow;ctx.fillStyle=g.open?'#ffd27a':'#61727a';ctx.beginPath();ctx.ellipse(x,y-6,17,48,0,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;if(g.open)circle(x,y-82,5,'#fff0bd');ctx.restore()}
function drawHero(){let h=hero,[x,y]=project(h.x,h.y),blink=h.invuln>0&&Math.floor(elapsed*15)%2===0;ctx.save();ctx.translate(x,y);if(blink)ctx.globalAlpha=.4;ctx.fillStyle='#09131c55';ctx.beginPath();ctx.ellipse(0,0,13,6,0,0,Math.PI*2);ctx.fill();let bob=Math.sin(elapsed*13)*1.3;rr(-7,-22+bob,6,18,2,'#273543');rr(2,-22-bob,6,18,2,'#273543');rr(-8,-5+bob,8,4,2,'#a76543');rr(1,-5-bob,8,4,2,'#a76543');poly([[-10,-38+bob],[7,-37-bob],[10,-15],[0,-12],[-12,-16]],'#bd5142');rr(-5,-39,12,20,4,'#e0ad68');circle(1,-48,9,'#d99b69');circle(0,-51,9,'#52372f');circle(7,-48,1.2,'#1b2430');let angle=Math.atan2(h.faceY,h.faceX);ctx.save();ctx.translate(8,-29);ctx.rotate(angle);if(h.attack>0){let p=1-h.attack/.35;ctx.rotate(-.8+p*1.7);line(0,0,28,-5,'#ece9da',3);line(0,0,7,0,'#a07848',3);ctx.strokeStyle=`rgba(255,240,185,${.6*(1-p)})`;ctx.lineWidth=2;ctx.beginPath();ctx.arc(0,0,27,-1,.8);ctx.stroke()}else{line(0,0,20,-7,'#e7e5d6',3);line(0,0,6,0,'#9d7043',3)}ctx.restore();ctx.restore()}
function drawEnemy(e){let [x,y]=project(e.x,e.y),bob=Math.abs(Math.sin(elapsed*7+e.phase))*2;ctx.save();ctx.translate(x,y);ctx.fillStyle='#263a3a99';ctx.beginPath();ctx.ellipse(0,0,15,6,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='#477755';ctx.beginPath();ctx.ellipse(0,-17-bob,15,13,0,Math.PI,0);ctx.lineTo(15,-5);ctx.quadraticCurveTo(0,2,-15,-5);ctx.fill();circle(-4,-17-bob,2.4,'#d7e99a');circle(5,-17-bob,2.4,'#d7e99a');circle(-3,-17-bob,1.2,'#182a27');circle(6,-17-bob,1.2,'#182a27');if(e.hp<2){rr(-11,-37,22,3,2,'#18232b');rr(-11,-37,11,3,2,'#ffc876')}ctx.restore()}
function drawBoss(b){let [x,y]=project(b.x,b.y),hue=['#659a63','#8ec8d4','#4e9c9b','#d97848','#9568bd'][b.region];ctx.save();ctx.translate(x,y);ctx.fillStyle='#1b283399';ctx.beginPath();ctx.ellipse(0,0,32,9,0,0,Math.PI*2);ctx.fill();ctx.fillStyle=hue;ctx.beginPath();ctx.ellipse(0,-29,32,29,0,Math.PI,0);ctx.lineTo(32,-5);ctx.quadraticCurveTo(0,7,-32,-5);ctx.fill();circle(-10,-30,4,'#ffe2a0');circle(10,-30,4,'#ffe2a0');line(-18,-8,-28,3,hue,5);line(18,-8,28,3,hue,5);rr(-34,-70,68,6,3,'#18232b');rr(-33,-69,66*(b.hp/b.maxHp),4,2,'#ff7468');ctx.restore()}
function drawCoin(c){let [x,y]=project(c.x,c.y),bob=Math.sin(elapsed*4+c.x)*3;circle(x,y+bob,8,'#9b682d');circle(x,y+bob,6,'#ffd36f');circle(x-2,y+bob-2,2,'#fff0bd');line(x,y+bob-4,x,y+bob+4,'#e7a443',2)}
function drawCheckpoint(c){let [x,y]=project(c.x,c.y);line(x,y,x,y-21,c.active?'#fbdc86':'#84928a',4);circle(x,y-23,5,c.active?'#ffd77c':'#bcc5a0');if(c.active){ctx.globalAlpha=.28+Math.sin(elapsed*5)*.1;circle(x,y-23,13,'#ffdb7d');ctx.globalAlpha=1}}
function drawWorld(){drawSky();drawGround();for(let x=100;x<WORLD;x+=200){drawTree(x,35,x);drawTree(x+80,MAP_H-35,x+900)}for(const g of gates)if(Math.abs(g.x-hero.x)<W/IX+200)drawGate(g);for(const c of checkpoints)if(Math.abs(c.x-hero.x)<W/IX+100)drawCheckpoint(c);for(const c of coins)if(!c.taken&&Math.abs(c.x-hero.x)<W/IX+100)drawCoin(c);for(const e of enemies)if(e.alive&&Math.abs(e.x-hero.x)<W/IX+100)drawEnemy(e);for(const b of bosses)if(b.alive&&Math.abs(b.x-hero.x)<W/IX+120)drawBoss(b);drawHero()}
function burst(x,y,color,n=8){for(let i=0;i<n;i++)particles.push({x,y,vx:(Math.random()-.5)*100,vy:-20-Math.random()*90,life:.35+Math.random()*.5,color,size:2+Math.random()*3})}
function hurt(){if(hero.invuln>0)return;hero.hp--;hero.invuln=1.25;let d=Math.hypot(hero.x-(hero._hitX||hero.x-1),hero.y-(hero._hitY||hero.y));hero.x=Math.max(0,hero.x-hero.faceX*22);hero.y=Math.max(0,Math.min(MAP_H,hero.y-hero.faceY*22));updateHUD();burst(hero.x,hero.y-14,'#ff7b69',8);if(hero.hp<=0){screen='dead';ui.eyebrow.textContent='THE FOREST CLAIMS ANOTHER';ui.title.textContent='Not the end';ui.message.textContent='Every blade can rise again. Your journey will begin at the last campfire.';ui.start.textContent='TRY AGAIN';ui.hint.textContent='Tip: line up your sword with a slime, then strike';ui.overlay.classList.remove('hidden')}}
function update(dt){elapsed+=dt;if(toastTimer>0&&((toastTimer-=dt)<=0))ui.toast.classList.remove('show');if(screen!=='playing')return;let h=hero,dx=(input.right?1:0)-(input.left?1:0),dy=(input.down?1:0)-(input.up?1:0),len=Math.hypot(dx,dy)||1;dx/=len;dy/=len;if(dx||dy){h.faceX=dx;h.faceY=dy}let speed=190;h.vx+=(dx*speed-h.vx)*Math.min(1,dt*11);h.vy+=(dy*speed-h.vy)*Math.min(1,dt*11);if(!dx)h.vx*=Math.pow(.08,dt);if(!dy)h.vy*=Math.pow(.08,dt);let nx=Math.max(0,Math.min(WORLD,h.x+h.vx*dt)),ny=Math.max(12,Math.min(MAP_H-12,h.y+h.vy*dt));let r=regionAt(h.x),gate=gates[r];if(gate&&!gate.open&&nx>gate.x-25&&h.x<=gate.x-25){nx=gate.x-25;h.vx=0}h.x=nx;h.y=ny;if(h.invuln>0)h.invuln-=dt;if(h.attack>0)h.attack=Math.max(0,h.attack-dt);if(h.attackCd>0)h.attackCd-=dt;if(input.attack&&h.attackCd<=0){h.attack=.35;h.attackCd=.38}
for(const c of coins)if(!c.taken&&Math.hypot(h.x-c.x,h.y-c.y)<28){c.taken=true;burst(c.x,c.y,'#ffd36f',9);updateHUD();showToast('A little treasure for the road')}
for(const cp of checkpoints)if(!cp.active&&Math.hypot(h.x-cp.x,h.y-cp.y)<30){checkpoints.forEach(p=>p.active=false);cp.active=true;h.checkpoint={x:cp.x,y:cp.y};showToast('Campfire found · progress saved');burst(cp.x,cp.y,'#ffd47d',12)}
for(const e of enemies){if(!e.alive)continue;let ex=h.x-e.x,ey=h.y-e.y,dist=Math.hypot(ex,ey);if(dist<175){e.x+=ex/(dist||1)*28*dt;e.y+=ey/(dist||1)*28*dt}else{e.x=e.homeX+Math.sin(elapsed*.6+e.phase)*24;e.y=e.homeY+Math.cos(elapsed*.5+e.phase)*20}if(h.attack>0&&dist<62&&((-ex)*h.faceX+(-ey)*h.faceY)>0){e.hp--;e.x-=h.faceX*16;e.y-=h.faceY*16;burst(e.x,e.y-16,'#a8da8e',7);h.attack=0;if(e.hp<=0){e.alive=false;burst(e.x,e.y-15,'#8bd17d',13);showToast('Forest slime defeated')}}else if(dist<29&&h.invuln<=0){h._hitX=e.x;h._hitY=e.y;hurt()}}
let region=regionAt(h.x),b=bosses[region],g=gates[region];if(b?.alive){b.hitCd=Math.max(0,b.hitCd-dt);let ex=h.x-b.x,ey=h.y-b.y,dist=Math.hypot(ex,ey);if(dist>54){b.x+=ex/(dist||1)*38*dt;b.y+=ey/(dist||1)*38*dt;b.x=Math.max(b.homeX-48,Math.min(b.homeX+48,b.x));b.y=Math.max(35,Math.min(MAP_H-35,b.y))}if(h.attack>0&&dist<75&&((-ex)*h.faceX+(-ey)*h.faceY)>0&&b.hitCd<=0){b.hp--;b.hitCd=.42;h.attack=0;burst(b.x,b.y-28,'#ffd57a',12);if(b.hp<=0){b.alive=false;keysFound++;g.open=true;burst(b.x,b.y-30,'#ffe7a0',26);updateHUD();updateQuest();showToast(`${REGIONS[region].name} key found!`)}else showToast(`${REGIONS[region].boss} · ${b.hp} strikes left`)}else if(dist<43&&h.invuln<=0){h._hitX=b.x;h._hitY=b.y;hurt()}}else if(g)g.open=true;
for(const p of particles){p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=80*dt;p.life-=dt}particles=particles.filter(p=>p.life>0);let tx=(h.x-h.y)*IX,ty=(h.x+h.y)*IY;camX+=(tx-camX)*Math.min(1,dt*4);camY+=(ty-camY)*Math.min(1,dt*4);updateQuest();if(keysFound===REGIONS.length&&h.x>gates[4].x+20){screen='win';ui.eyebrow.textContent='THE PROPHECY FULFILLED';ui.title.textContent='The Way Home';ui.message.textContent='The fifth key turns in the ancient portal. Its light opens onto the familiar forest where your journey began. You have saved five nations—and found your way home.';ui.start.textContent='PLAY AGAIN';ui.hint.textContent='Five nations · Five guardians · Five keys';ui.overlay.classList.remove('hidden')}}
function drawParticles(){for(const p of particles){let [x,y]=project(p.x,p.y);ctx.globalAlpha=Math.min(1,p.life*2);circle(x,y-8,p.size,p.color)}ctx.globalAlpha=1}
function frame(now){let dt=Math.min(.033,(now-last)/1000||0);last=now;update(dt);ctx.setTransform(dpr,0,0,dpr,0,0);drawWorld();drawParticles();requestAnimationFrame(frame)}requestAnimationFrame(frame);
})();
</script>
</body>
</html>
